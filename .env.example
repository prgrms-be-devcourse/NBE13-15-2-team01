# 로컬 환경이 팀 공통값과 다르거나, 비밀값이 필요할 때 사용
# 사용법: 이 파일을 복사해 .env 로 만들고, 필요한 줄만 주석 해제 후 값 입력
#   cp .env.example .env
# .env 는 깃에 올라가지 않음 (각자 로컬에만 보관)

# ===== DB (기본값 있음, 팀 공통값과 다를 때만 작성) =====
# DB_URL=jdbc:mysql://localhost:3306/ticketing?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
# DB_USERNAME=ticketing
# DB_PASSWORD=ticketing1234

# ===== 추후 추가 예정 (기본값 없음, 실제 값은 팀 채널로 공유) =====
# JWT_SECRET=
# KOPIS_API_KEY=